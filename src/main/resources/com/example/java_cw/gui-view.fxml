<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.java_cw.MainController">

    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #1A3A6B; -fx-padding: 10px;">
        <ImageView fx:id="logoImage" fitHeight="150" fitWidth="150" preserveRatio="true">
            <image>
                <Image url="@tuk_tuk_3.png" />
            </image>
        </ImageView>
        <VBox spacing="4">
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;" text="TUK TUK SPARE PARTS" />
            <Label style="-fx-font-size: 18px; -fx-text-fill: red; -fx-font-weight: bold;" text=" MALABE " />
        </VBox>
    </HBox>

    <TabPane fx:id="mainTabPane" style="-fx-background-color: white;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Inventory">
            <VBox spacing="10" style="-fx-padding: 15px; -fx-background-color: white;">


                <VBox fx:id="lowStockBox" spacing="5" style="-fx-background-color: #E6E6E6;                              -fx-border-color: #CC2229;                              -fx-border-width: 1px;                              -fx-padding: 10px;                              -fx-background-radius: 5px;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #CC2229; -fx-font-size: 13px;" text="LOW STOCK WARNING" />
                    <Label fx:id="lowStockLabel" style="-fx-text-fill: black;" text="Loading..." />

                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <TextField fx:id="searchField" prefWidth="250" promptText="Search by name, brand or ID..." style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;" />
                    <ComboBox fx:id="categoryFilter" promptText="All Categories" style="-fx-padding: 6px;" />
                    <TextField fx:id="minPriceField" prefWidth="100" promptText="Min Price" style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;" />
                    <TextField fx:id="maxPriceField" prefWidth="100" promptText="Max Price" style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;" />
                    <Button fx:id="searchButton" onAction="#onSearchClicked" style="-fx-background-color: #1A3A6B;                                    -fx-text-fill: white;                                    -fx-padding: 8px 15px;                                    -fx-background-radius: 4px;                                    -fx-font-weight: bold;" text="Search" />
                    <Button onAction="#onResetClicked" style="-fx-background-color: #CC2229;                                    -fx-text-fill: white;                                    -fx-padding: 8px 15px;                                    -fx-background-radius: 4px;                                    -fx-font-weight: bold;" text="Reset" />
                </HBox>

                <TableView fx:id="inventoryTable" style="-fx-background-color: white;                                   -fx-border-color: #DDDDDD;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPartId" prefWidth="80" text="Part ID" />
                        <TableColumn fx:id="colPartName" prefWidth="200" text="Part Name" />
                        <TableColumn fx:id="colBrand" prefWidth="100" text="Brand" />
                        <TableColumn fx:id="colPrice" prefWidth="100" text="Price (Rs.)" />
                        <TableColumn fx:id="colQuantity" prefWidth="60" text="Qty" />
                        <TableColumn fx:id="colCategory" prefWidth="100" text="Category" />
                        <TableColumn fx:id="colDate" prefWidth="110" text="Date Added" />
                        <TableColumn fx:id="colImage" prefWidth="90" text="Images" />
                        <TableColumn fx:id="colThreshold" prefWidth="90" text="Threshold" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1A3A6B;                              -fx-padding: 10px;                              -fx-background-radius: 5px;">
                    <Label fx:id="totalCountLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Total Parts: 0" />
                    <Label style="-fx-text-fill: white;" text="|" />
                    <Label fx:id="totalValueLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Total Value: Rs. 0.00" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddPartClicked" style="-fx-background-color: white;                                    -fx-text-fill: #1A3A6B;                                    -fx-font-weight: bold;                                    -fx-padding: 6px 15px;                                    -fx-background-radius: 4px;" text="Add Part" />
                    <Button onAction="#onEditPartClicked" style="-fx-background-color: white;                                    -fx-text-fill: #1A3A6B;                                    -fx-font-weight: bold;                                    -fx-padding: 6px 15px;                                    -fx-background-radius: 4px;" text="Edit Part" />
                    <Button onAction="#onDeletePartClicked" style="-fx-background-color: #CC2229;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-padding: 6px 15px;                                    -fx-background-radius: 4px;" text="Delete Part" />
                </HBox>

            </VBox>
        </Tab>

        <Tab text="Dealers">
            <VBox spacing="10" style="-fx-padding: 15px; -fx-background-color: #F5F5F5;">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="Randomly Selected Dealers (sorted by location)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onRefreshDealerClicked" style="-fx-background-color: #1A3A6B; -fx-text-fill: white; -fx-padding: 8px 15px; -fx-background-radius: 4px; -fx-font-weight: bold;" text="Select Dealers" />
                </HBox>

                <TableView fx:id="dealersTable" style="-fx-background-color: white; -fx-border-color: #DDDDDD;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDealerId" prefWidth="100" text="Dealer ID" />
                        <TableColumn fx:id="colDealerName" prefWidth="220" text="Dealer Name" />
                        <TableColumn fx:id="colDealerPhone" prefWidth="150" text="Phone" />
                        <TableColumn fx:id="colDealerLocation" prefWidth="200" text="Location" />
                    </columns>
                </TableView>

            </VBox>
        </Tab>

        <Tab text="Point of Sale">
            <VBox fx:id="posPane" spacing="10" style="-fx-padding: 15px; -fx-background-color: #F5F5F5;" />
            <fx:include fx:id="posView" source="pos-view.fxml" />

        </Tab>
        <Tab text="Audit Log">
            <fx:include fx:id="auditLogView" source="audit-log-view.fxml" />
        </Tab>

    </TabPane>

</VBox>

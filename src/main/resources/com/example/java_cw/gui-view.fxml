<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.java_cw.MainController"
      style="-fx-background-color: #F5F5F5;">

    <!-- HEADER -->
    <HBox style="-fx-background-color: #1A3A6B; -fx-padding: 15px;"
          alignment="CENTER_LEFT" spacing="15">
        <ImageView fx:id="logoImage" fitHeight="60" fitWidth="60" preserveRatio="true"/>
        <VBox spacing="2">
            <Label text="TUK TUK SPARE PARTS"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="~ MALABE ~"
                   style="-fx-font-size: 12px; -fx-text-fill: #CC2229; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- TAB PANE -->
    <TabPane fx:id="mainTabPane"
             tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: #F5F5F5;"
             VBox.vgrow="ALWAYS">


        <Tab text="Inventory">
            <VBox spacing="10" style="-fx-padding: 15px; -fx-background-color: #F5F5F5;">


                <VBox fx:id="lowStockBox"
                      spacing="5"
                      style="-fx-background-color: #FFF3CD;
                             -fx-border-color: #CC2229;
                             -fx-border-width: 1px;
                             -fx-padding: 10px;
                             -fx-background-radius: 5px;">
                    <Label text="LOW STOCK WARNING"
                           style="-fx-font-weight: bold; -fx-text-fill: #CC2229; -fx-font-size: 13px;"/>
                    <Label fx:id="lowStockLabel"
                           text="Loading..."
                           style="-fx-text-fill: #856404;"/>
                </VBox>


                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="Search by name, brand or ID..."
                               prefWidth="250"
                               style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;"/>
                    <ComboBox fx:id="categoryFilter"
                              promptText="All Categories"
                              style="-fx-padding: 6px;"/>
                    <TextField fx:id="minPriceField"
                               promptText="Min Price"
                               prefWidth="100"
                               style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;"/>
                    <TextField fx:id="maxPriceField"
                               promptText="Max Price"
                               prefWidth="100"
                               style="-fx-padding: 8px; -fx-border-color: #1A3A6B; -fx-border-radius: 4px;"/>
                    <Button fx:id="searchButton"
                            text="Search"
                            onAction="#onSearchClicked"
                            style="-fx-background-color: #1A3A6B;
                                   -fx-text-fill: white;
                                   -fx-padding: 8px 15px;
                                   -fx-background-radius: 4px;
                                   -fx-font-weight: bold;"/>
                    <Button text="Reset"
                            onAction="#onResetClicked"
                            style="-fx-background-color: #CC2229;
                                   -fx-text-fill: white;
                                   -fx-padding: 8px 15px;
                                   -fx-background-radius: 4px;
                                   -fx-font-weight: bold;"/>
                </HBox>


                <TableView fx:id="inventoryTable"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white;
                                  -fx-border-color: #DDDDDD;">
                    <columns>
                        <TableColumn fx:id="colPartId" text="Part ID" prefWidth="80"/>
                        <TableColumn fx:id="colPartName" text="Part Name" prefWidth="200"/>
                        <TableColumn fx:id="colBrand" text="Brand" prefWidth="100"/>
                        <TableColumn fx:id="colPrice" text="Price (Rs.)" prefWidth="100"/>
                        <TableColumn fx:id="colQuantity" text="Qty" prefWidth="60"/>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="100"/>
                        <TableColumn fx:id="colDate" text="Date Added" prefWidth="110"/>
                    </columns>
                </TableView>


                <HBox spacing="20"
                      style="-fx-background-color: #1A3A6B;
                             -fx-padding: 10px;
                             -fx-background-radius: 5px;"
                      alignment="CENTER_LEFT">
                    <Label fx:id="totalCountLabel"
                           text="Total Parts: 0"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="|" style="-fx-text-fill: white;"/>
                    <Label fx:id="totalValueLabel"
                           text="Total Value: Rs. 0.00"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Add Part"
                            onAction="#onAddPartClicked"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1A3A6B;
                                   -fx-font-weight: bold;
                                   -fx-padding: 6px 15px;
                                   -fx-background-radius: 4px;"/>
                    <Button text="Edit Part"
                            onAction="#onEditPartClicked"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1A3A6B;
                                   -fx-font-weight: bold;
                                   -fx-padding: 6px 15px;
                                   -fx-background-radius: 4px;"/>
                    <Button text="Delete Part"
                            onAction="#onDeletePartClicked"
                            style="-fx-background-color: #CC2229;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-padding: 6px 15px;
                                   -fx-background-radius: 4px;"/>
                </HBox>

            </VBox>
        </Tab>


        <Tab text="Dealers">
            <VBox fx:id="dealersPane" spacing="10"
                  style="-fx-padding: 15px; -fx-background-color: #F5F5F5;"/>
        </Tab>


        <Tab text="Point of Sale">
            <VBox fx:id="posPane" spacing="10"
                  style="-fx-padding: 15px; -fx-background-color: #F5F5F5;"/>
        </Tab>

    </TabPane>

</VBox>